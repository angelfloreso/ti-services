  <section class="does" id="does" aria-labelledby="s1">
    <div class="container">
      <div class="head">
        <h2 id="s1">Four jobs, one stream</h2>
        <p class="lead">What Relay does between your providers and your endpoint.</p>
      </div>
      <div class="switch" data-switch="">
        <div class="tabs" role="tablist" aria-label="What Relay does">
          <button role="tab" id="t-typed" aria-controls="p-typed" aria-selected="true" tabindex="0"><span class="tabs__n" aria-hidden="true">1</span>Types</button>
