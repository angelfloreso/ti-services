                <p class="insp__file"><code>evt_1042.json</code></p>
<pre class="code code--insp"><code><span class="p">{</span>
  <span class="ln" data-k="type"><span class="n">"type"</span><span class="p">:</span> <span class="s">"invoice.paid"</span><span class="p">,</span></span>
  <span class="ln" data-k="id"><span class="n">"id"</span><span class="p">:</span> <span class="s">"evt_1042"</span><span class="p">,</span></span>
  <span class="ln is-on" data-k="amount"><span class="n">"amount"</span><span class="p">:</span> <span class="s">4800</span><span class="p">,</span></span>
  <span class="ln" data-k="currency"><span class="n">"currency"</span><span class="p">:</span> <span class="s">"GBP"</span><span class="p">,</span></span>
  <span class="ln" data-k="paid_at"><span class="n">"paid_at"</span><span class="p">:</span> <span class="s">"2026-10-08T09:42:16Z"</span></span>
<span class="p">}</span></code></pre>
              </div>
              <div class="insp__pane">
                <p class="insp__file"><code>invoice-paid.ts</code></p>
<pre class="code code--insp"><code><span class="c">// inferred from evt_1042</span>
<span class="k">export type</span> <span class="t">InvoicePaid</span> = {
  <span class="ln" data-k="type">type: <span class="s">"invoice.paid"</span>;</span>
  <span class="ln" data-k="id">id: <span class="t">string</span>;</span>
  <span class="ln is-on" data-k="amount">amount: <span class="t">number</span>;</span>
  <span class="ln" data-k="currency">currency: <span class="s">"GBP"</span>;</span>
  <span class="ln" data-k="paid_at">paid_at: <span class="t">string</span>;</span>
};</code></pre>
              </div>
              <div class="insp__wires" aria-hidden="true"><i class="wire-c" data-k="type" style="--n: 0; --r: 10px;"><i class="wire-c__node" style="left: 342px; top: 166px; width: 5px; height: 5px;"></i><i class="wire-c__h" style="left: 344px; top: 168px; width: 283px; height: 1px;"></i><i class="wire-c__e wire-c__e--tr" style="left: 627px; top: 168px; width: 10px; height: 10px;"></i><i class="wire-c__e wire-c__e--bl" style="left: 636px; top: 178px; width: 11px; height: 11px;"></i><i class="wire-c__h" style="left: 647px; top: 188px; width: 110px; height: 1px;"></i><i class="wire-c__node" style="left: 755px; top: 186px; width: 5px; height: 5px;"></i></i><i class="wire-c" data-k="id" style="--n: 1; --r: 10px;"><i class="wire-c__node" style="left: 270px; top: 206px; width: 5px; height: 5px;"></i><i class="wire-c__h" style="left: 272px; top: 208px; width: 364px; height: 1px;"></i><i class="wire-c__e wire-c__e--tr" style="left: 636px; top: 208px; width: 10px; height: 10px;"></i><i class="wire-c__e wire-c__e--bl" style="left: 645px; top: 218px; width: 11px; height: 11px;"></i><i class="wire-c__h" style="left: 656px; top: 228px; width: 101px; height: 1px;"></i><i class="wire-c__node" style="left: 755px; top: 226px; width: 5px; height: 5px;"></i></i><i class="wire-c is-on" data-k="amount" style="--n: 2; --r: 10px;"><i class="wire-c__node" style="left: 246px; top: 246px; width: 5px; height: 5px;"></i><i class="wire-c__h" style="left: 248px; top: 248px; width: 398px; height: 1px;"></i><i class="wire-c__e wire-c__e--tr" style="left: 646px; top: 248px; width: 10px; height: 10px;"></i><i class="wire-c__e wire-c__e--bl" style="left: 655px; top: 258px; width: 11px; height: 11px;"></i><i class="wire-c__h" style="left: 666px; top: 268px; width: 91px; height: 1px;"></i><i class="wire-c__node" style="left: 755px; top: 266px; width: 5px; height: 5px;"></i></i><i class="wire-c" data-k="currency" style="--n: 3; --r: 10px;"><i class="wire-c__node" style="left: 282px; top: 286px; width: 5px; height: 5px;"></i><i class="wire-c__h" style="left: 284px; top: 288px; width: 372px; height: 1px;"></i><i class="wire-c__e wire-c__e--tr" style="left: 656px; top: 288px; width: 10px; height: 10px;"></i><i class="wire-c__e wire-c__e--bl" style="left: 665px; top: 298px; width: 11px; height: 11px;"></i><i class="wire-c__h" style="left: 676px; top: 308px; width: 81px; height: 1px;"></i><i class="wire-c__node" style="left: 755px; top: 306px; width: 5px; height: 5px;"></i></i><i class="wire-c" data-k="paid_at" style="--n: 4; --r: 10px;"><i class="wire-c__node" style="left: 462px; top: 326px; width: 5px; height: 5px;"></i><i class="wire-c__h" style="left: 464px; top: 328px; width: 201px; height: 1px;"></i><i class="wire-c__e wire-c__e--tr" style="left: 665px; top: 328px; width: 10px; height: 10px;"></i><i class="wire-c__e wire-c__e--bl" style="left: 674px; top: 338px; width: 11px; height: 11px;"></i><i class="wire-c__h" style="left: 685px; top: 348px; width: 72px; height: 1px;"></i><i class="wire-c__node" style="left: 755px; top: 346px; width: 5px; height: 5px;"></i></i></div>
            </div>
          </figure>
        </div>

        <div class="panel" role="tabpanel" id="p-retry" aria-labelledby="t-retry" tabindex="0" hidden="">
          <p class="panel__say">When your endpoint is down, Relay holds <code>evt_1042</code> and tries again: a 503, a timeout, then 200 OK.</p>
          <figure class="tl" data-tl="">
            <ol class="tl__at" aria-label="Delivery attempts of evt_1042 to example.com/hooks/billing, spaced by time">
              <li class="tl__a tl__a--bad" style="--at: 0"><span class="tl__fig">503</span><span class="tl__what">Service Unavailable in 2.1 s</span><code>Attempt 1, 09:42:18</code></li>
              <li class="tl__a tl__a--bad" style="--at: 0.3333"><span class="tl__fig">10.0 s</span><span class="tl__what">No answer, timed out</span><code>Attempt 2, 09:42:48</code></li>
              <li class="tl__a tl__a--good" style="--at: 1"><span class="tl__fig">200</span><span class="tl__what">OK in 182 ms</span><code>Attempt 3, 09:43:48</code></li>
            </ol>
            <div class="tl__rule" aria-hidden="true"><i class="tl__ink"></i><i class="tl__span tl__span--bad" style="--at: 0; --dur: 0.0233"></i><i class="tl__span tl__span--bad" style="--at: 0.3333; --dur: 0.1111"></i><i class="tl__span tl__span--good" style="--at: 0.998; --dur: 0.002"></i><i class="tl__cursor"></i></div>
            <div class="tl__dims" aria-hidden="true">
              <span class="tl__dim" style="--from: 0; --to: 0.3333"><span><code>30 s</code> later</span></span>
              <span class="tl__dim" style="--from: 0.3333; --to: 1"><span><code>60 s</code> later</span></span>
            </div>
          </figure>
        </div>

        <div class="panel" role="tabpanel" id="p-replay" aria-labelledby="t-replay" tabindex="0" hidden="">
          <p class="panel__say">Send any past event to your endpoint again, straight from the stream.</p>
          <div class="rp" data-replay="">
            <canvas class="rp__field" aria-hidden="true"></canvas>
            <div class="rp__in">
              <div class="rp__head"><h3 class="rp__title">Replay</h3><code>invoice.paid</code><code class="rp__id">evt_1042</code></div>
              <dl class="rp__fields">
                <dt>Event</dt><dd><code>evt_1042, invoice.paid</code></dd>
                <dt>Destination</dt><dd><code>https://example.com/hooks/billing</code></dd>
              </dl>
              <div class="rp__go">
                <button class="key key--primary" type="button" data-replay-go=""><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-2.64-6.36"></path><path d="M21 3v6h-6"></path></svg>Replay event</button>
                <span class="rp__hint">Sends the stored payload as it arrived</span>
              </div>
              <ol class="rp__log" aria-label="Recent replays" aria-live="polite">
                <li class="rp__line"><code>09:58:14</code><span>Replayed <code>evt_1042</code></span><code class="ok">200 OK</code><code>164 ms</code></li>
                <li class="rp__line"><code>09:31:02</code><span>Replayed <code>evt_0987</code></span><code class="ok">200 OK</code><code>201 ms</code></li>
                <li class="rp__line"><code>08:12:40</code><span>Replayed <code>evt_0961</code></span><code class="ok">200 OK</code><code>176 ms</code></li>
              </ol>
              <div class="curl curl--dark" data-copy="curl --json @evt_1042.json https://example.com/hooks/billing">
                <code class="curl__cmd"><span class="curl__p" aria-hidden="true">$</span>curl --json @evt_1042.json https://example.com/hooks/billing</code>
                <button class="curl__copy" type="button" aria-label="Copy the same request as curl"><span class="curl__say" aria-live="polite">Copy</span></button>
              </div>
            </div>
          </div>
        </div>

        <div class="panel" role="tabpanel" id="p-in" aria-labelledby="t-in" tabindex="0" hidden="">
          <p class="panel__say">One address for each provider. Every webhook lands in one stream, whoever sent it.</p>
          <div class="table-wrap" role="region" aria-label="Sources" tabindex="0">
            <table class="src">
              <thead><tr><th scope="col">Source</th><th scope="col">Posts to</th><th scope="col">Event types seen</th><th scope="col" class="r">Last event</th></tr></thead>
              <tbody>
                <tr><th scope="row">shop.example.com</th><td><code>relay.example.com/in/shop</code></td><td><code>order.created</code> <code>order.shipped</code></td><td class="r"><code>09:42:31</code></td></tr>
                <tr class="is-on"><th scope="row">billing.example.com</th><td><code>relay.example.com/in/billing</code></td><td><code>invoice.paid</code> <code>refund.issued</code></td><td class="r"><code>09:42:18</code></td></tr>
                <tr><th scope="row">crm.example.com</th><td><code>relay.example.com/in/crm</code></td><td><code>customer.updated</code> <code>contact.merged</code></td><td class="r"><code>09:41:55</code></td></tr>
                <tr><th scope="row">forms.example.com</th><td><code>relay.example.com/in/forms</code></td><td><code>form.submitted</code></td><td class="r"><code>09:39:40</code></td></tr>
              </tbody>
            </table>
          </div>
          <p class="src__out">All four deliver to <code>https://example.com/hooks</code></p>
        </div>
      </div>
    </div>
  </section>

  <section class="offer" id="pricing" aria-labelledby="s5">
    <div class="container offer__grid">
      <div class="offer__head">
        <h2 class="offer__fig" id="s5">100,000 events a month, free.</h2>
        <div class="actions">
          <a class="key key--primary" href="#top" data-needs-url="signup">Start free</a>
